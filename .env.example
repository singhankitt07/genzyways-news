# Local dev: sqlite file. Production: swap to a Postgres URL (Neon/Supabase) — see README.
DATABASE_URL="file:./dev.db"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Configure one email provider for password reset links.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="GenzyWayNews <no-reply@example.com>"
# Or use Resend instead of SMTP: RESEND_API_KEY="re_..."

# Google Analytics 4 Measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Google AdSense values, available after your AdSense site is approved
NEXT_PUBLIC_ADSENSE_CLIENT="ca-pub-XXXXXXXXXXXXXXXX"
NEXT_PUBLIC_ADSENSE_HOME_SLOT=""
NEXT_PUBLIC_ADSENSE_ARTICLE_SLOT=""

# Used once by `npm run seed` to create your first admin login
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="ChangeThisPassword123!"
