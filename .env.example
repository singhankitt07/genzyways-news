# PostgreSQL connection string for local and production environments.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Configure one email provider for password reset links.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="GenzyWayNews <no-reply@example.com>"
# Or use Resend instead of SMTP: RESEND_API_KEY="re_..."
RESEND_API_KEY=""
NEWSLETTER_FROM="GenzyWays News <news@example.com>"

# Google Analytics 4 Measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Google AdSense values, available after your AdSense site is approved
NEXT_PUBLIC_ADSENSE_CLIENT="ca-pub-XXXXXXXXXXXXXXXX"
NEXT_PUBLIC_ADSENSE_HOME_SLOT=""
NEXT_PUBLIC_ADSENSE_ARTICLE_SLOT=""

# Used once by `npm run seed` to create your first admin login
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="ChangeThisPassword123!"

# Optional legacy single-provider config. Used when AI_PROVIDERS is not set.
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# Optional ordered provider chain. Set AI_PROVIDERS=primary,backup1, then configure
# AI_PRIMARY_URL, AI_PRIMARY_KEY, AI_PRIMARY_MODEL (and corresponding backup variables).
# Keys are server-side only. Names are case-insensitive in environment variable names.
# AI_PROVIDERS="primary,backup1"
# AI_PRIMARY_URL="https://api.openai.com/v1"
# AI_PRIMARY_KEY=""
# AI_PRIMARY_MODEL="gpt-4o-mini"
# AI_BACKUP1_URL="https://api.groq.com/openai/v1"
# AI_BACKUP1_KEY=""
# AI_BACKUP1_MODEL="llama-3.3-70b-versatile"

# AI newsroom automation
# Required for the cron endpoint (Vercel sends it as a Bearer token)
CRON_SECRET=""
# Optional: NewsAPI.org provider key (server-side only; never commit the real value)
NEWS_API_KEY=""

# Cashfree one-time checkout (server-only credentials)
CASHFREE_CLIENT_ID=""
CASHFREE_CLIENT_SECRET=""
CASHFREE_ENVIRONMENT="sandbox"
