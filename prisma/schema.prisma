generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  password     String
  name         String        @default("Editor")
  nameChangeTimestamps DateTime[] @default([])
  role         String        @default("READER")
  age          Int?
  dateOfBirth  DateTime?
  country      String?
  state        String?
  city         String?
  address      String?
  pinCode      String?
  preferences  String?
  image        String?
  bio          String?
  preferredLanguage String @default("en")
  theme        String @default("auto")
  readingFontSize Int @default(18)
  emailAlerts  Boolean @default(true)
  pushAlerts   Boolean @default(true)
  subscription Subscription?
  passwordResetTokens PasswordResetToken[]
  comments Comment[]
  commentVotes CommentVote[]
  reactions ArticleReaction[]
  bookmarks Bookmark[]
  readingHistory ReadingHistory[]
  categoryFollows CategoryFollow[]
  commentReports CommentReport[]
}

model Article {
  id             String   @id @default(cuid())
  title          String
  titleHi        String?
  slug           String   @unique
  summary        String
  summaryHi      String?
  content        String
  contentHi      String?
  contentFormat  String   @default("MARKDOWN")
  contentHiFormat String  @default("MARKDOWN")
  imageUrl       String?
  sourceName     String?
  sourceUrl      String?
  category       String
  author         String   @default("Staff Reporter")
  authorId       String?
  breaking       Boolean  @default(false)
  live           Boolean  @default(false)
  subscriberOnly Boolean  @default(false)
  published      Boolean  @default(false)
  publishedHi    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  comments       Comment[]
  reactions      ArticleReaction[]
  bookmarks      Bookmark[]
  readingHistory ReadingHistory[]
  media          ArticleMedia[]
  views          ArticleView[]
  authorProfile  Author? @relation(fields: [authorId], references: [id], onDelete: SetNull)
}

enum ArticleMediaType {
  IMAGE
  VIDEO
}

model ArticleMedia {
  id             String           @id @default(cuid())
  articleId      String
  type           ArticleMediaType
  url            String
  caption        String?
  paragraphIndex Int              @default(0)
  sortOrder      Int              @default(0)
  createdAt      DateTime         @default(now())
  article        Article          @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, paragraphIndex, sortOrder])
}

model Author {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  role        String
  bio         String
  photo       String?
  socialLinks String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  articles    Article[]
}

enum MediaKind {
  SHORT
  VIDEO
}

model MediaVideo {
  id           String   @id @default(cuid())
  title        String
  description  String?
  url          String
  thumbnailUrl String?
  kind         MediaKind
  published    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum EbookFormat {
  PDF
  EPUB
}

model Ebook {
  id          String      @id @default(cuid())
  slug        String      @unique
  title       String
  titleHi     String?
  summary     String
  summaryHi   String?
  category    String
  author      String      @default("GenzyWays News Desk")
  language    String      @default("en")
  format      EbookFormat
  fileUrl     String
  coverUrl    String?
  sources     String?
  published   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([published, createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  editedAt  DateTime?
  deletedAt DateTime?
  moderationStatus String   @default("VISIBLE")
  articleId String
  userId    String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  votes     CommentVote[]
  reports   CommentReport[]

  @@index([articleId, createdAt])
  @@index([parentId])
}

model CommentVote {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
}

model ArticleReaction {
  id        String   @id @default(cuid())
  articleId String
  userId    String
  type      String
  createdAt DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([articleId, userId, type])
  @@index([articleId, type])
}

model Bookmark {
  id        String   @id @default(cuid())
  articleId String
  userId    String
  createdAt DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([articleId, userId])
}

model ReadingHistory {
  id          String   @id @default(cuid())
  articleId   String
  userId      String
  progress    Int      @default(0)
  lastReadAt  DateTime @default(now())
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([articleId, userId])
  @@index([userId, lastReadAt])
}

model CategoryFollow {
  id       String   @id @default(cuid())
  userId   String
  category String
  createdAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
}

model CommentReport {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  reason    String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 String
  status               String    @default("INACTIVE")
  stripeCustomerId     String?
  stripeSubscriptionId String?   @unique
  razorpayOrderId      String?
  razorpayPaymentId    String?
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Subscriber {
  id                     String   @id @default(cuid())
  email                  String   @unique
  status                 String   @default("ACTIVE")
  confirmationTokenHash  String?  @unique
  confirmationExpiresAt  DateTime?
  unsubscribeTokenHash   String?  @unique
  createdAt              DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}


// ---------------------------------------------------------------------------
// AI newsroom automation. AI state is kept separate from the published Article.
// ---------------------------------------------------------------------------

model NewsSource {
  id            String     @id @default(cuid())
  name          String
  provider      String     @default("rss") // rss | newsapi
  kind          String     @default("PUBLISHER") // OFFICIAL | GOVERNMENT | PUBLISHER | AGGREGATOR
  url           String     @unique
  category      String     @default("Current Affairs")
  config        Json?
  enabled       Boolean    @default(true)
  pollMinutes   Int        @default(30)
  lastFetchedAt DateTime?
  lastStatus    String?
  lastError     String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  items         NewsItem[]
}

model NewsItem {
  id               String     @id @default(cuid())
  sourceId         String
  externalId       String?
  originalUrl      String
  urlHash          String     @unique
  title            String
  titleFingerprint String
  description      String?
  publishedAt      DateTime?
  retrievedAt      DateTime   @default(now())
  category         String
  meta             Json?
  clusterId        String?
  source           NewsSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  cluster          StoryCluster? @relation(fields: [clusterId], references: [id], onDelete: SetNull)

  @@index([clusterId])
  @@index([titleFingerprint])
  @@index([publishedAt])
  @@index([sourceId, retrievedAt])
}

model AIProcessingJob {
  id          String    @id @default(cuid())
  type        String
  key         String    @unique
  status      String    @default("PENDING") // PENDING | RUNNING | DONE | FAILED
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  runAt       DateTime  @default(now())
  lockedAt    DateTime?
  payload     Json?
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  finishedAt  DateTime?

  @@index([status, runAt])
}

model AutomationLog {
  id        String   @id @default(cuid())
  level     String   @default("INFO") // INFO | WARN | ERROR
  action    String
  message   String
  entity    String?
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

model AutomationSettings {
  id                String   @id @default("default")
  enabled           Boolean  @default(false)
  pollMinutes       Int      @default(30)
  categories        String[] @default([])
  minImportance     Int      @default(2)
  autoResearch      Boolean  @default(false)
  autoDraft         Boolean  @default(false)
  requireApproval   Boolean  @default(true)
  aiProvider        String   @default("openai-compatible")
  aiModel           String?
  maxRequestsPerDay Int      @default(200)
  maxTokensPerDay   Int      @default(200000)
  updatedAt         DateTime @updatedAt
}

model StoryCluster {
  id                String     @id @default(cuid())
  title             String
  titleFingerprint  String
  category          String
  status            String     @default("NEW") // NEW | IGNORED | RESEARCHING | RESEARCHED | DRAFTED | PUBLISHED
  importance        Int        @default(0)
  riskLevel         String     @default("LOW") // LOW | MEDIUM | HIGH
  sourceCount       Int        @default(1)
  itemCount         Int        @default(1)
  existingArticleId String?
  firstSeenAt       DateTime   @default(now())
  lastSeenAt        DateTime   @default(now())
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  items             NewsItem[]
  reports           ResearchReport[]
  drafts            ArticleDraft[]

  @@index([status, importance])
  @@index([lastSeenAt])
}

model ResearchReport {
  id        String               @id @default(cuid())
  clusterId String
  summary   String
  model     String?
  status    String               @default("DONE") // DONE | FAILED
  error     String?
  createdAt DateTime             @default(now())
  cluster   StoryCluster         @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  sources   ResearchSource[]
  claims    FactClaim[]
  result    VerificationResult?

  @@index([clusterId, createdAt])
}

model ResearchSource {
  id          String         @id @default(cuid())
  reportId    String
  position    Int
  title       String
  url         String
  domain      String
  sourceName  String
  kind        String         // OFFICIAL | GOVERNMENT | PUBLISHER | AGGREGATOR
  credibility Int            @default(50)
  snippet     String?
  publishedAt DateTime?
  report      ResearchReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model FactClaim {
  id          String         @id @default(cuid())
  reportId    String
  text        String
  status      String         // SUPPORTED | SINGLE_SOURCE | CONFLICTING
  sourceCount Int            @default(1)
  sourceRefs  Int[]
  note        String?
  report      ResearchReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model VerificationResult {
  id            String         @id @default(cuid())
  reportId      String         @unique
  verdict       String         // VERIFIED | PARTIAL | UNVERIFIED | CONFLICTING
  confidence    Int            @default(0)
  riskLevel     String         @default("LOW")
  needsHuman    Boolean        @default(true)
  conflicts     String[]       @default([])
  notes         String?
  createdAt     DateTime       @default(now())
  report        ResearchReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model ArticleDraft {
  id             String        @id @default(cuid())
  clusterId      String
  reportId       String?
  title          String
  summary        String
  content        String
  titleHi        String?
  summaryHi      String?
  contentHi      String?
  category       String
  slug           String
  seoTitle       String
  seoDescription String
  keywords       String[]      @default([])
  status         String        @default("IN_REVIEW") // IN_REVIEW | APPROVED | REJECTED | PUBLISHED
  riskLevel      String        @default("LOW")
  needsHuman     Boolean       @default(true)
  verdict        String?
  confidence     Int           @default(0)
  model          String?
  articleId      String?
  reviewedBy     String?
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  cluster        StoryCluster  @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  reviews        AIReview[]

  @@index([status, createdAt])
  @@index([clusterId])
}

model AIReview {
  id        String       @id @default(cuid())
  draftId   String
  action    String       // CREATED | EDITED | APPROVED | REJECTED | PUBLISHED | REGENERATED
  actor     String
  note      String?
  createdAt DateTime     @default(now())
  draft     ArticleDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId, createdAt])
}

model ArticleView {
  articleId String
  day       DateTime @db.Date
  views     Int      @default(1)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([articleId, day])
  @@index([day])
}